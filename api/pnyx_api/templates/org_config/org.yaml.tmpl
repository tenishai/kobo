# org.yaml — this repo's only content.
#
# This repo (pnyx-config) holds ROOM configuration for pnyx, the agent
# assembly room — nothing else. It is never where team content lives: no
# skills, no personas, no agent bundles. Those are catalog data, published to
# their own GCS buckets (see README.md in this repo for the split). Every key
# below is one field of pnyx_api.config.Config that pnyx merges over its own
# local defaults at boot (pnyx_api.org.load_org_config) — the same allowlist
# that governs which keys here are ever read is pnyx_api.org.ORG_KEYS; an
# unrecognized key is rejected rather than silently ignored.
#
# Rendered once by pnyx's bootstrap CLI from the values it ran with — review
# and edit freely from here on, this file is the org's source of truth.

github_org: __PNYX_GITHUB_ORG__
skills_repo: __PNYX_SKILLS_REPO__
skills_bucket: __PNYX_SKILLS_BUCKET__
personas_bucket: __PNYX_PERSONAS_BUCKET__
gojira_cluster: __PNYX_GOJIRA_CLUSTER__
runtime_image: __PNYX_RUNTIME_IMAGE__
gcp_project: __PNYX_GCP_PROJECT__
vertex_project: __PNYX_VERTEX_PROJECT__
vertex_location: __PNYX_VERTEX_LOCATION__
model_group: __PNYX_MODEL_GROUP__
avatar_model: __PNYX_AVATAR_MODEL__
avatar_location: __PNYX_AVATAR_LOCATION__
models: __PNYX_MODELS__
skills_publish_wif_provider: __PNYX_SKILLS_PUBLISH_WIF_PROVIDER__
skills_publish_service_account: __PNYX_SKILLS_PUBLISH_SERVICE_ACCOUNT__
skills_publish_external: __PNYX_SKILLS_PUBLISH_EXTERNAL__
