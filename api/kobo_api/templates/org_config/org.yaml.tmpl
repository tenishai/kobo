# org.yaml — this repo's only content.
#
# This repo (kobo-config) holds ROOM configuration for kobo, the agent
# assembly room — nothing else. It is never where team content lives: no
# skills, no personas, no agent bundles. Those are catalog data, published to
# their own GCS buckets (see README.md in this repo for the split). Every key
# below is one field of kobo_api.config.Config that kobo merges over its own
# local defaults at boot (kobo_api.org.load_org_config) — the same allowlist
# that governs which keys here are ever read is kobo_api.org.ORG_KEYS; an
# unrecognized key is rejected rather than silently ignored.
#
# Rendered once by kobo's bootstrap CLI from the values it ran with — review
# and edit freely from here on, this file is the org's source of truth.

github_org: __KOBO_GITHUB_ORG__
skills_repo: __KOBO_SKILLS_REPO__
skills_bucket: __KOBO_SKILLS_BUCKET__
personas_bucket: __KOBO_PERSONAS_BUCKET__
gojira_cluster: __KOBO_GOJIRA_CLUSTER__
runtime_image: __KOBO_RUNTIME_IMAGE__
# Agent techne databases replicate continuously to this bucket; empty means
# replication is off and composed bundles carry no supervision.
memory_replica_bucket: __KOBO_MEMORY_REPLICA_BUCKET__
# One runtime, bundles as artifacts: the registry path each agent's bundle is published to
# (<registry>/<agent>-bundle:current), mounted by the deploy platform at /bundle. Empty builds
# every change into the agent's image instead.
bundle_registry: __KOBO_BUNDLE_REGISTRY__

# The room's own in-cluster base URL, as deployed agents reach it -- powers
# the github.open_pr tool (the PR broker). Empty = agents get no github
# tools at all.
broker_url: __KOBO_BROKER_URL__
# The room's model gateway, in-cluster, as the room and its agents reach it.
# Empty = off: models come from the list below and agents reach them with
# their own identity. Set, models come from the clouds connected under
# Admin > Integrations and every new agent reaches them through the gateway
# with a key the room mints for it.
models_gateway_url: __KOBO_MODELS_GATEWAY_URL__
liminal_url: __KOBO_LIMINAL_URL__
# The room's permission service (bab), in-cluster. Empty = Access is off.
bab_url: __KOBO_BAB_URL__

# Noto dashboard link for this room's agents (Task 4). Both null (the
# default) means the observability catalog is off -- the UI shows no
# Noto link. A half-configured pair (only one set) is treated the same
# as both unset; see kobo_api.main's /api/catalog/observability route.
noto_url: __KOBO_NOTO_URL__
noto_project: __KOBO_NOTO_PROJECT__

# Raw Okta group names whose members can SEE every agent (visibility only,
# never any mutation power). Empty list = nobody holds the reader role.
reader_groups: __KOBO_READER_GROUPS__
gcp_project: __KOBO_GCP_PROJECT__
vertex_project: __KOBO_VERTEX_PROJECT__
vertex_location: __KOBO_VERTEX_LOCATION__
model_group: __KOBO_MODEL_GROUP__
avatar_model: __KOBO_AVATAR_MODEL__
avatar_location: __KOBO_AVATAR_LOCATION__
models: __KOBO_MODELS__
skills_publish_wif_provider: __KOBO_SKILLS_PUBLISH_WIF_PROVIDER__
skills_publish_service_account: __KOBO_SKILLS_PUBLISH_SERVICE_ACCOUNT__
skills_publish_external: __KOBO_SKILLS_PUBLISH_EXTERNAL__

# Emails allowed to use the Slack connect routes once IAP is enabled —
# everyone else gets a 403. Empty (the default) leaves Slack connect open to
# anyone who can reach this room.
slack_operators: __KOBO_SLACK_OPERATORS__

# Emails allowed to destroy an agent once IAP is enabled — everyone else
# gets a 403. Empty (the default) leaves destruction open to anyone who can
# reach this room.
operators: __KOBO_OPERATORS__

# Names from the groups list below whose members hold operator status
# room-wide (they see every agent, pass every owner-or-operator gate, and
# can send or accept an invite on any side) -- resolved through the
# directory, same as the groups below. Empty (the default) means no group
# has admin standing; the operators list above is unaffected either way.
# Every entry here must also be a name in the groups list below, or the
# room fails to start. Removing someone from the backing directory group
# can take up to the resolver's cache TTL (900s default) to take effect
# here. Keep at least one operators email set as break-glass, since a
# directory outage takes group-based admin status down with it.
admin_groups: __KOBO_ADMIN_GROUPS__
# The admin panel (#/admin: add-ons, integrations, connections, roles, people,
# audit). Off until a room turns it on; its entry shows only to admins.
admin_panel: __KOBO_ADMIN_PANEL__
# Slack as a vendor on the Access tab: the room makes an agent's Slack app
# itself and relays Slack's events to the agent, so no app-level token is
# pasted. Off until the flow is proven on one room; off changes nothing.
slack_relay: __KOBO_SLACK_RELAY__
# Where the account menu's "Log out" goes: the identity proxy's sign-out path
# (Google's proxy: /_gcp_iap/clear_login_cookie). Unset hides the item.
logout_url: __KOBO_LOGOUT_URL__
# Where an integration connected from the admin panel lands: the tool
# gateway's config repository (a pull request adds the vendor's target) and
# the namespace the gateway runs in (its credential is synced there).
gateway_config_repo: __KOBO_GATEWAY_CONFIG_REPO__
gateway_namespace: __KOBO_GATEWAY_NAMESPACE__
# The tool gateway's admin plane, so a lane granted from the panel applies
# at once (the room's own token, persona kobo-room). Empty: pull request only.
liminal_admin_url: __KOBO_LIMINAL_ADMIN_URL__

# Base URL of the switchboard (cabal) service this room registers agents
# with and (once wired) relays chat through, and the template for an
# agent's in-cluster a2a endpoint (the directory sync substitutes the
# agent's name into it via Python str.format, so the name goes inside a
# single pair of curly braces). Both null (the default) means the
# switchboard integration is off — the room runs the legacy
# direct-to-agent paths unchanged. The operator token itself is never set
# here; it comes from this room's own CABAL_OPERATOR_TOKEN env var.
cabal_url: __KOBO_CABAL_URL__
agent_endpoint_template: __KOBO_AGENT_ENDPOINT_TEMPLATE__

# The ACL axis: named groups this room can grant an agent's audience to,
# each mapped to the directory's own group name, plus the directory's org
# domain group lookups hit. Empty groups / empty okta_domain (the default)
# means group-based access is off — only owners and operators (above) can
# see anything gated behind it.
groups: __KOBO_GROUPS__
okta_domain: __KOBO_OKTA_DOMAIN__

# Google OAuth + JWT signing coordinates for kobo's MCP server (MCP server
# arc, Task 1). Empty oauth_client_id (the default) means the MCP server is
# off, same as cabal_url above; an enabled server also requires BOTH
# workspace_domain (the org gate on the MCP path) AND issuer_base_url (the
# room's own external base URL, e.g. https://kobo.example, which the OAuth
# discovery documents and Google redirect URI are built from) to be set, or
# the room refuses to start. oauth_client_secret_env / jwt_key_env are ENV
# VAR NAMES, not secret values themselves -- NEVER put a real secret in this
# or any tracked file.
mcp: __KOBO_MCP__
