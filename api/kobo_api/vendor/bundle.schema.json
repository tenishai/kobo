  "additionalProperties": true,
  "description": "Wiring for a daedalus agent bundle \u2014 a directory that IS an agent (agent.yaml + persona.md + agent-card.json). Unknown fields load with a warning, never silently.",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "card": {
      "default": "agent-card.json",
      "title": "Card",
      "type": "string"
    },
    "persona": {
      "default": "persona.md",
      "title": "Persona",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/ModelSpec"
    },
    "transports": {
      "items": {
        "$ref": "#/$defs/TransportSpec"
      },
      "title": "Transports",
      "type": "array"
    },
    "tools": {
